    },
    "about_view.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "about_view.driver.and.car.photography.is.resolved.from": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Driver and car photography is resolved from Wikimedia Commons with author and license credits. The app icon is original AI-generated artwork. Profile summaries require editorial verification before commercial publication."
          }
        }
      }
    },
    "about_view.driver.profiles.are.fetched.from.f1db.with": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Driver profiles are fetched from F1DB, with an offline cache and a curated collection of sourced personal cars. This is a curated starting collection, not an exhaustive driver database."
          }
        }
      }
    },
    "about_view.favorites.and.cached.content.are.stored.on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorites and cached content are stored on this device. F1DB and Wikimedia receive normal web requests when data and photos are loaded. There are no accounts, ads or analytics SDKs. Opening a source link takes you to an external website with its own privacy policy."
          }
        }
      }
    },
    "about_view.formula.intellectual.property.guidelines": {
