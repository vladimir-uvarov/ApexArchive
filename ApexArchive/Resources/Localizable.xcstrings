    "driver.bruce-mclaren.biography": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruce McLaren founded the racing company that carried his name and helped develop the M6GT road-car prototype. He used it on the road himself. The project shows how his work as a driver and engineer extended beyond competition, although the later McLaren F1 road car was developed long after his death."
          }
        }
      }
    },
