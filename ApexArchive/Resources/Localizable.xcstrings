      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Monégasque driver whose rise through junior racing led to Sauber and Ferrari. His qualifying performances and connection to his home race are central to his story."
          }
        }
      }
    },
