{
  "sourceLanguage": "en",
  "strings": {
    "about.collections": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About the collections"
          }
        }
      }
    },
    "about.collections.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modern icons and legends are editorial selections, not current standings. Car connections and circuit preferences describe their cited sources at the stated dates; they are not claims about current ownership or an exhaustive list."
          }
        }
      }
    },
    "about.data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Race data"
          }
        }
      }
    },
    "about.data.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Race statistics and debut seasons come from F1DB, by Marcel Overdijk and contributors, licensed under CC BY 4.0. ApexArchive selects and reformats fields and combines them with original editorial content. F1DB provides no warranty or endorsement."
          }
        }
      }
    },
    "about.data.license": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data license · CC BY 4.0"
          }
        }
      }
    },
    "about.f1db": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "F1DB terms and attribution"
          }
        }
      }
    },
    "about.independent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent archive"
          }
        }
      }
    },
    "about.independent.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ApexArchive is an independent racing-history publication. It is not associated with or endorsed by Formula 1, the FIA, drivers, teams, manufacturers or data providers. Names and images identify editorial subjects; all relevant rights remain with their holders."
          }
        }
      }
    },
    "about.photos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photography"
          }
        }
      }
    },
    "about.photos.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are resolved through Wikimedia Commons and screened against recognized reuse licences or a public-domain rights statement. Every displayed photo links to its author, supplied credit notices, licence and source. Metadata is not a guarantee of all third-party rights. Images may be resized or cropped for display."
          }
        }
      }
    },
    "about.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        }
      }
    },
    "about.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorites and caches stay on your device. GitHub and Wikimedia receive normal connection information when the app requests data or images. There are no accounts, ads, analytics SDKs or subscriptions. Read Privacy information in Settings for details."
          }
        }
      }
    },
    "about.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About the archive"
          }
        }
      }
    },
    "about_view.about.the.archive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
