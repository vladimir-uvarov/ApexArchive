    "about_view.apex.archive.is.a.working.name.for": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apex Archive is a working name for an independent editorial prototype. It is not affiliated with or endorsed by Formula 1, any team, or any driver."
          }
        }
      }
    },
    "about_view.before.launch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before launch"
          }
        }
      }
    },
    "about_view.clear.the.app.name.content.and.media": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the app name, content and media rights for your launch markets. Review commercial use, driver likenesses, store requirements and a final privacy policy with qualified counsel."
          }
        }
      }
    },
    "about_view.content.and.imagery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
