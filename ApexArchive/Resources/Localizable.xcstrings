    "car.alonso-valiant.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valiant began with Alonso’s request for a lighter, more track-focused interpretation of Valour. Aston Martin identifies him as its first customer; the announcement concerns the commission rather than proof of delivery."
          }
        }
      }
    },
