    "driver.hunt.biography": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A British world champion whose rivalry with Niki Lauda became one of the sport’s most widely remembered stories. He later worked as a television commentator."
