    "life.bruce-mclaren-engineering.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruce McLaren founded the racing company that carried his name and helped develop the M6GT road-car prototype. He used it on the road himself. The project shows how his work as a driver and engineer extended beyond competition, although the later McLaren F1 road car was developed long after his death."
          }
        }
      }
    },
    "life.bruce-mclaren-engineering.impact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Founded a car-building company and helped develop the M6GT, an early McLaren road-car prototype that he drove himself."
          }
        }
      }
    },
    "life.bruce-mclaren-engineering.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruce McLaren’s road-car ambition"
          }
        }
      }
    },
    "life.carroll-shelby-engineering.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carroll Shelby founded Shelby American in 1962. The Cobra paired an AC-derived chassis with Ford V8 power, and his company later developed Mustang-based performance cars with Ford. These were collaborative engineering projects whose identity became inseparable from Shelby’s name."
          }
        }
      }
    },
    "life.carroll-shelby-engineering.impact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Established Shelby American and brought together AC chassis and Ford V8 power in the Cobra, followed by performance-car projects with Ford."
          }
        }
      }
    },
    "life.carroll-shelby-engineering.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From racing driver to Shelby American"
          }
        }
      }
    },
    "life.dan-gurney-engineering.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan Gurney helped develop the small trailing-edge wing device known as the Gurney flap for racing cars. It became an enduring tool in race-car aerodynamics. His work also extended to building cars: he co-founded All American Racers with Carroll Shelby, producing the Eagle racing cars."
          }
        }
      }
    },
    "life.dan-gurney-engineering.impact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helped develop the Gurney flap for race-car wings: a small aerodynamic device with a lasting role in racing-car design. Also co-founded the manufacturer behind the Eagle cars."
          }
        }
      }
    },
    "life.dan-gurney-engineering.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small flap with a lasting influence"
          }
        }
      }
    },
    "life.emerson-fittipaldi-engineering.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emerson Fittipaldi became a partner with his brother Wilson in the Brazilian-backed Fittipaldi team. He left McLaren to drive for the family operation in 1976. The project represented a commitment to building and racing their own cars, rather than simply driving for an established constructor."
          }
        }
      }
    },
    "life.emerson-fittipaldi-engineering.impact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnered with Wilson Fittipaldi in a Brazilian-backed constructor and drove its cars. His documented role here was as a partner and driver, rather than the sole chassis designer."
          }
        }
      }
    },
    "life.emerson-fittipaldi-engineering.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Fittipaldi family’s constructor"
          }
        }
      }
    },
    "life.hamilton-mission44.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lewis Hamilton founded Mission 44 to support young people facing barriers in education and employment. The foundation connects his experiences growing up with work to make opportunities more inclusive."
          }
        }
      }
    },
    "life.hamilton-mission44.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening doors through Mission 44"
          }
        }
      }
    },
    "life.jack-brabham-engineering.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack Brabham and designer Ron Tauranac established Motor Racing Developments to build racing cars. Their partnership combined Brabham’s driving and mechanical experience with Tauranac’s design expertise. In 1966 Brabham won the drivers’ championship in a car bearing his own name."
          }
        }
      }
    },
    "life.jack-brabham-engineering.impact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Co-founded a racing-car manufacturer with Ron Tauranac. Brabham supplied driving and mechanical experience, while Tauranac led the design work."
          }
        }
      }
    },
    "life.jack-brabham-engineering.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building Brabham with Ron Tauranac"
          }
        }
      }
    },
    "life.john-surtees-engineering.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "John Surtees expanded from driving into building racing cars. His team entered Formula 1 as a constructor in 1970 with the Surtees TS7. Before that chassis was ready, he raced a purchased McLaren M7C—an illustration of the practical steps behind establishing a new constructor."
          }
        }
      }
    },
    "life.john-surtees-engineering.impact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Established his own Formula 1 constructor and fielded the Surtees TS7 in 1970, moving from driving other manufacturers’ cars to running a car-building operation."
          }
        }
      }
    },
    "life.john-surtees-engineering.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A constructor bearing his name"
          }
        }
      }
    },
    "life.lauda-airline.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Niki Lauda’s interest in aviation became Lauda Air. He was not only the airline’s owner but also one of its pilots, taking his working life from racing circuits into commercial aviation."
          }
        }
      }
    },
    "life.lauda-airline.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An airline owner who also flew"
          }
        }
      }
    },
    "life.leclerc-piano.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charles Leclerc released his piano composition AUS23 (1:1) in 2023. He described playing piano as a way to disconnect from racing; the title refers to the Australian Grand Prix around which he created the piece."
          }
        }
      }
    },
    "life.leclerc-piano.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quieter kind of performance"
          }
        }
      }
    },
    "life.rosberg-greentech.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nico Rosberg is a co-founder of the Greentech Festival. The event brings together people and organisations working on sustainability and technology, marking another direction in his life after championship racing."
          }
        }
      }
    },
    "life.rosberg-greentech.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stage for greener technology"
          }
        }
      }
    },
    "life.senna-education.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Instituto Ayrton Senna works on education in Brazil. It was founded in November 1994 by his sister Viviane and the Senna family after his death, carrying forward his wish for children to have greater opportunities. This is his legacy, rather than an organisation he personally founded."
          }
        }
      }
    },
    "life.senna-education.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An educational legacy"
          }
        }
      }
    },
    "life.stewart-dementia.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jackie Stewart founded Race Against Dementia in 2016. The charity funds research into dementia prevention and treatment, bringing his public profile to a cause far beyond motorsport."
          }
        }
      }
    },
    "life.stewart-dementia.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A race with a different purpose"
          }
        }
      }
    },
    "life.vettel-biodiversity.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebastian Vettel’s Buzzin’ Corner project invited drivers and team figures to help draw attention to biodiversity. It connects a familiar racing setting with a different subject: protecting the variety of life around us."
          }
        }
      }
    },
    "life.vettel-biodiversity.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Making room for biodiversity"
          }
        }
      }
    },
    "life.villeneuve-music.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jacques Villeneuve released the album Private Paradise in 2007. The former World Champion appears in AllMusic’s discography as its primary artist, with a piano credit as well—a less familiar chapter of his career."
          }
        }
      }
    },
    "life.villeneuve-music.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the cockpit to the recording studio"
          }
        }
      }
    },
    "museum.alfa.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arese, Italy"
          }
        }
      }
    },
    "museum.alfa.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace Alfa Romeo through its road cars, design and racing heritage. A fitting companion to the archive’s stories of the marque’s early Grand Prix success."
          }
        }
      }
    },
    "museum.brooklands.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weybridge, United Kingdom"
          }
        }
      }
    },
    "museum.brooklands.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The site of the world’s first purpose-built motor racing circuit, opened in 1907. Sections of the original banking still stand and can be walked."
          }
        }
      }
    },
    "museum.donington.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Castle Donington, United Kingdom"
          }
        }
      }
    },
    "museum.donington.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pre-war Grand Prix venue that returned to Formula One for a single wet race in 1993. Still active, with a full events calendar."
          }
        }
      }
    },
    "museum.fangio.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balcarce, Argentina"
          }
        }
      }
    },
    "museum.fangio.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five world titles, documented in the Argentine town where Fangio was born and is buried. The collection covers the road-racing era that shaped him."
          }
        }
      }
    },
    "museum.ferrari.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maranello, Italy"
          }
        }
      }
    },
    "museum.ferrari.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A natural stop for Ferrari followers: explore the marque’s road and racing history in the town where its cars are built. Pair the visit with time in Italy’s Motor Valley."
          }
        }
      }
    },
    "museum.goodwood.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chichester, United Kingdom"
          }
        }
      }
    },
    "museum.goodwood.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A post-war circuit kept close to its original form, best known now for historic meetings. Access is tied to the event and track-day calendar."
          }
        }
      }
    },
    "museum.hockenheim.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hockenheim, Germany"
          }
        }
      }
    },
    "museum.hockenheim.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stadium section survives from a much longer forest layout. A motorsport museum sits at the circuit; confirm its hours separately."
          }
        }
      }
    },
    "museum.imola.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imola, Italy"
          }
        }
      }
    },
    "museum.imola.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parkland setting is open outside events, and memorials to Ayrton Senna and Roland Ratzenberger stand near the circuit. Visitors treat both as places of remembrance."
          }
        }
      }
    },
    "museum.jimclark.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duns, United Kingdom"
          }
        }
      }
    },
    "museum.jimclark.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A museum in the Borders town Jim Clark called home, devoted to the two-time World Champion. Small, specific and a quiet counterpoint to the factory collections."
          }
        }
      }
    },
    "museum.lamborghini.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sant’Agata Bolognese, Italy"
          }
        }
      }
    },
    "museum.lamborghini.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lamborghini’s own collection sits beside the factory, a short drive from Maranello. Convenient if you are already touring Italy’s Motor Valley and want more than one marque in a day."
          }
        }
      }
    },
    "museum.louwman.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Hague, Netherlands"
          }
        }
      }
    },
    "museum.louwman.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A broad private collection strong on early motoring and coachwork. Useful context for how racing cars and road cars diverged."
          }
        }
      }
    },
    "museum.mauto.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turin, Italy"
          }
        }
      }
    },
    "museum.mauto.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the oldest automobile museums in the world, telling the story of the car as an object and an industry. Turin’s own motoring history runs through the collection."
          }
        }
      }
    },
    "museum.mercedes.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuttgart, Germany"
          }
        }
      }
    },
    "museum.mercedes.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A broader journey through automotive history, with road vehicles and motorsport woven together. A useful way to place the Silver Arrows’ story in its wider engineering context."
          }
        }
      }
    },
    "museum.monaco.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte Carlo, Monaco"
          }
        }
      }
    },
    "museum.monaco.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The circuit is ordinary public road for most of the year, so the corners can simply be walked. Casino Square, the tunnel exit and Rascasse are all within a short route."
          }
        }
      }
    },
    "museum.monza.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monza, Italy"
          }
        }
      }
    },
    "museum.monza.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In continuous use since 1922 and set inside a royal park. The abandoned banked oval still stands away from the modern track and is the reason many people come."
          }
        }
      }
    },
    "museum.nurburgring.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nürburg, Germany"
          }
        }
      }
    },
    "museum.nurburgring.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Nordschleife opens to the public on tourist-driving days, and the Karussell can be reached on foot. Check opening and closure notices before travelling."
          }
        }
      }
    },
    "museum.petersen.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Angeles, United States"
          }
        }
      }
    },
    "museum.petersen.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wide-ranging exhibits on car culture, design and competition, with rotating displays. A good stop if your interest runs past Grand Prix racing alone."
          }
        }
      }
    },
    "museum.porsche.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuttgart, Germany"
          }
        }
      }
    },
    "museum.porsche.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore the connection between Porsche’s sports cars, engineering and competition history. Particularly rewarding if the stories behind racing technology interest you."
          }
        }
      }
    },
    "museum.schlumpf.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulhouse, France"
          }
        }
      }
    },
    "museum.schlumpf.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The former Schlumpf collection, including an exceptional row of Bugattis. Worth the detour for anyone interested in pre-war Grand Prix machinery."
          }
        }
      }
    },
    "museum.silverstone.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silverstone, United Kingdom"
          }
        }
      }
    },
    "museum.silverstone.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover the people and stories behind British motorsport at Silverstone. The museum makes a natural addition to a trip to the circuit; access arrangements can differ on major event weekends."
          }
        }
      }
    },
    "museum.spa.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavelot, Belgium"
          }
        }
      }
    },
    "museum.spa.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eau Rouge and Raidillon read very differently in person than on television; the gradient is the point. Public access depends on the event calendar and track days."
          }
        }
      }
    },
    "museum.villeneuve.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Berthierville, Canada"
          }
        }
      }
    },
    "museum.villeneuve.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilles Villeneuve’s home town keeps his story in the open, from karting beginnings to Ferrari. A reminder of how local a Grand Prix career can start."
          }
        }
      }
    },
    "museum.zandvoort.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zandvoort, Netherlands"
          }
        }
      }
    },
    "museum.zandvoort.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laid out through coastal dunes, which gives the banking and elevation their character. Reachable by train from Amsterdam on event days."
          }
        }
      }
    },
    "museums.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five places to explore the cars, people and engineering beyond the screen."
          }
        }
      }
    },
    "museums.map.fallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still search for the museum in Apple Maps below."
          }
        }
      }
    },
    "museums.map.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding the museum…"
          }
        }
      }
    },
    "museums.map.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map unavailable"
          }
        }
      }
    },
    "museums.maps": {
      "extractionState": "manual",
      "localizations": {
